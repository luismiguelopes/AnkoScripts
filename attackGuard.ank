//////////////////////////////////////
// SETTINGS

reactMinSeconds = 240           // fleetsave between this many seconds...
reactMaxSeconds = 480           // ...and this many before impact (random each time)
fleetSpeed = TEN_PERCENT        // slow = longer flight, so the recall comes back sooner after impact
safeTarget = nil                // e.g. "M:2:100:10"; nil = nearest own planet/moon in another system
recallDelayMin = 30             // recall between these seconds after the impact
recallDelayMax = 120
idlePollMin = 180               // seconds between checks when nothing is incoming
idlePollMax = 300

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

// Count of one ship type in a ShipsInfos
func ShipCount(allShips, shipType) {
    if shipType == LIGHTFIGHTER { return allShips.LightFighter }
    if shipType == HEAVYFIGHTER { return allShips.HeavyFighter }
    if shipType == CRUISER { return allShips.Cruiser }
    if shipType == BATTLESHIP { return allShips.Battleship }
    if shipType == SMALLCARGO { return allShips.SmallCargo }
    if shipType == LARGECARGO { return allShips.LargeCargo }
    if shipType == COLONYSHIP { return allShips.ColonyShip }
    if shipType == BATTLECRUISER { return allShips.Battlecruiser }
    if shipType == BOMBER { return allShips.Bomber }
    if shipType == DESTROYER { return allShips.Destroyer }
    if shipType == DEATHSTAR { return allShips.Deathstar }
    if shipType == RECYCLER { return allShips.Recycler }
    if shipType == ESPIONAGEPROBE { return allShips.EspionageProbe }
    if shipType == REAPER { return allShips.Reaper }
    if shipType == PATHFINDER { return allShips.Pathfinder }
    return 0
}

// Adds every flying ship explicitly (SetAllShips() is undocumented and the cargo must count every ship)
func AddAllShips(fleet, ships) {
    for t in [LIGHTFIGHTER, HEAVYFIGHTER, CRUISER, BATTLESHIP, BATTLECRUISER, BOMBER, DESTROYER, DEATHSTAR, SMALLCARGO, LARGECARGO, COLONYSHIP, RECYCLER, ESPIONAGEPROBE, REAPER, PATHFINDER] {
        n = ShipCount(ships, t)
        if n > 0 {
            fleet.AddShips(t, n)
        }
    }
}

// Loads as much as the cargo holds: deuterium first, then crystal, then metal.
// Replaces SetAllResources(), which left the fleets empty. Call it after the ships are added.
// The flight's fuel stays on the celestial and its space is kept free in the cargo.
// ships: a ShipsInfos with exactly the ships in the fleet (Cargo() does not accept the fleet builder).
// Returns the total loaded (0 on error, the fleet still leaves with its ships).
func LoadAllResources(fleet, celestial, ships) {
    res, err = celestial.GetResources()
    if err != nil {
        Notify("warn", "" + celestial.GetCoordinate() + ": could not read resources, fleet leaves empty: " + err)
        return 0
    }
    _, fuel = fleet.FlightTime()
    space = -1
    try {
        space = Cargo(ships) - fuel
    } catch e {
        Notify("warn", "Cargo() failed (" + e + "), falling back to SetAllResources")
        fleet.SetAllResources()
        return 0
    }
    if space < 0 { space = 0 }
    d = res.Deuterium - fuel
    if d < 0 { d = 0 }
    if d > space { d = space }
    space = space - d
    c = res.Crystal
    if c > space { c = space }
    space = space - c
    m = res.Metal
    if m > space { m = space }
    fleet.SetResources(NewResources(Floor(m), Floor(c), Floor(d)))
    return Floor(m) + Floor(c) + Floor(d)
}


handled = {}        // "ID" / "ID_seen" -> true (already fleetsaved / reported)
reactAtFor = {}     // "ID" -> seconds before impact to react (picked once per attack)
pendingRecalls = [] // [fleetID, recallAtTimestamp, fromCoord, toCoord]

func SameSpot(a, b) {
    return a.Galaxy == b.Galaxy && a.System == b.System && a.Position == b.Position && a.Type == b.Type
}

// Nearest own planet/moon in another system (falls back to any other celestial)
func PickSafeTarget(fromCoord) {
    if safeTarget != nil {
        return GetCachedCelestial(safeTarget).GetCoordinate()
    }
    best = nil
    bestDist = 1000000
    fallback = nil
    for list in [GetCachedPlanets(), GetCachedMoons()] {
        for c in list {
            cc = c.Coordinate
            if SameSpot(cc, fromCoord) {
                continue
            }
            if fallback == nil {
                fallback = cc
            }
            if cc.Galaxy != fromCoord.Galaxy || cc.System == fromCoord.System {
                continue
            }
            dist = cc.System - fromCoord.System
            if dist < 0 {
                dist = -dist
            }
            if dist < bestDist {
                bestDist = dist
                best = cc
            }
        }
    }
    if best != nil {
        return best
    }
    return fallback
}

// Sends everything away from the attacked celestial and schedules the recall
func FleetSave(ev) {
    from = ev.Destination
    recallAt = GetTimestamp() + ev.ArriveIn + Random(recallDelayMin, recallDelayMax)

    // Same celestial already saved (e.g. a grouped attack wave): just push the recall back
    for r in pendingRecalls {
        if SameSpot(r[2], from) {
            if recallAt > r[1] {
                r[1] = recallAt
            }
            Notify("info", "🛡️ " + from + " already fleetsaved, recall moved to cover this attack too")
            return
        }
    }

    to = PickSafeTarget(from)
    if to == nil {
        Notify("error", "🛡️ No safe target for " + from + ", fleet stays!")
        return
    }

    fleet = NewFleet()
    fleet.SetOrigin(from)
    fleet.SetDestination(to)
    fleet.SetSpeed(fleetSpeed)
    fleet.SetMission(PARK)
    ships, err = GetCachedCelestial(from).GetShips()
    if err != nil {
        Notify("error", "🛡️ Could not read ships on " + from + ": " + err + ". Act manually!")
        return
    }
    AddAllShips(fleet, ships)
    LoadAllResources(fleet, GetCachedCelestial(from), ships)
    fleet, err = fleet.SendNow()
    if err != nil {
        Notify("error", "🛡️ Fleetsave from " + from + " FAILED: " + err + ". Act manually!")
        return
    }

    pendingRecalls += [[fleet.ID, recallAt, from, to]]
    Notify("report", "🛡️ Fleetsave " + from + " ➡️ " + to + ". Recall in " + ShortDur(recallAt - GetTimestamp()))
}

// Recalls fleets whose attack already hit
func ProcessRecalls() {
    now = GetTimestamp()
    remaining = []
    for r in pendingRecalls {
        if r[1] > now {
            remaining += [r]
            continue
        }
        err = CancelFleet(r[0])
        if err != nil {
            Notify("warn", "🛡️ Could not recall fleet " + r[2] + " ➡️ " + r[3] + " (already landed?): " + err)
        } else {
            Notify("report", "🛡️ Attack passed, fleet recalled back to " + r[2])
        }
    }
    pendingRecalls = remaining
}

// Seconds to sleep before the next check
func CheckAttacks() {
    attacks, err = GetAttacks()
    if err != nil {
        Notify("error", "attackGuard: could not read attacks: " + err)
        return Random(30, 60)
    }

    nextCheck = Random(idlePollMin, idlePollMax)
    for ev in attacks {
        key = "" + ev.ID
        isAttack = ev.MissionType == ATTACK || ev.MissionType == GROUPEDATTACK
        if !isAttack {
            if handled[key] != true {
                handled[key] = true
                Notify("warn", "👀 Hostile mission " + ev.MissionType + " from " + ev.AttackerName + " on " + ev.Destination + " in " + ShortDur(ev.ArriveIn))
            }
            continue
        }
        if handled[key] == true {
            continue
        }

        if reactAtFor[key] == nil {
            reactAtFor[key] = Random(reactMinSeconds, reactMaxSeconds)
        }
        reactAt = reactAtFor[key]
        if ev.ArriveIn <= reactAt {
            handled[key] = true
            Notify("warn", "⚔️ " + ev.AttackerName + " hits " + ev.Destination + " in " + ShortDur(ev.ArriveIn) + ", fleetsaving")
            FleetSave(ev)
        } else {
            // Wake up in time for this attack
            untilReact = ev.ArriveIn - reactAt
            if untilReact < nextCheck {
                nextCheck = untilReact
            }
            if handled[key + "_seen"] != true {
                handled[key + "_seen"] = true
                Notify("warn", "⚔️ Incoming attack from " + ev.AttackerName + " on " + ev.Destination + " in " + ShortDur(ev.ArriveIn))
            }
        }
    }

    // Wake up in time for the next recall too
    now = GetTimestamp()
    for r in pendingRecalls {
        if r[1] - now < nextCheck {
            nextCheck = r[1] - now
        }
    }
    if nextCheck < 10 {
        nextCheck = 10
    }
    return nextCheck
}

Notify("report", "🛡️ attackGuard started")
for {
    ProcessRecalls()
    sleepSecs = CheckAttacks()
    Notify("info", "attackGuard: next check in " + ShortDur(sleepSecs))
    Sleep(sleepSecs * 1000)
}
