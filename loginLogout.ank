///////////////////////////////////////////////////////
UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

///////////////////////////////////////////////////////
//Hours number
x = 5


///////////////////////////////////////////////////////

func sleepLogout() {

    SendTelegram(TELEGRAM_CHAT_ID, UserName+ "  (" +UniverseName + ") ::: Offline for: " +x+ " hours." )
    Sleep(x*60*60*1000)
    
    
}


Logout()
sleepLogout()
Login()





SendTelegram(TELEGRAM_CHAT_ID, UserName+ "  (" +UniverseName + ") ::: Online" )
