//////////////////////////////////////
// SETTINGS

minHoursOffline = 4
maxHoursOffline = 6

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

//////////////////////////////////////
// MAIN

offlineMinutes = Random(minHoursOffline * 60, maxHoursOffline * 60)

Notify("report", "Offline for " + ShortDur(offlineMinutes * 60))
Logout()
Sleep(offlineMinutes * 60 * 1000)
Login()
Notify("report", "Online")
