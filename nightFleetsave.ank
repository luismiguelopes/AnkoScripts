//////////////////////////////////////
// SETTINGS

sendFrom = GetHomeWorld()                   // planet/moon to fleetsave from (or "M:1:2:3")
sendTo = NewCoordinate(0, 0, 0, PLANET_TYPE) // EDIT: fleetsave target
fleetSpeed = TEN_PERCENT                    // TEN_PERCENT ... HUNDRED_PERCENT

// The fleet is back home at a random time between these hours tomorrow
returnFromHour = 10
returnToHour = 11
timezoneOffsetHours = 1                     // server time minus UTC (was the old "- 3600")

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

func Pad2(n) {
    if n < 10 {
        return "0" + n
    }
    return "" + n
}

// Timestamp for a date at midnight (UTC) plus secondsInDay
func UnixFromDate(y, m, d, secondsInDay) {
    t = Unix(0, 0).AddDate(y - 1970, m - 1, d - 1)
    return t.Unix() + secondsInDay
}

if sendTo.Galaxy == 0 {
    Notify("error", "nightFleetsave: set sendTo in the settings first")
    return
}
origin = GetCachedCelestial(sendFrom)
if origin == nil {
    Notify("error", "nightFleetsave: " + sendFrom + " is not one of your planets/moons")
    return
}

// Pick the return time tomorrow
returnSecondOfDay = Random(returnFromHour * 3600, returnToHour * 3600)
year, month, day = Date()
now = GetTimestamp()
returnTimestamp = UnixFromDate(year, month, day + 1, returnSecondOfDay) - timezoneOffsetHours * 3600
delta = returnTimestamp - now

// Outbound until cancel + same time back = delta, so cancel halfway
waitBeforeCancel = Floor(delta / 2)

// The fleet must still be in the air when we cancel, or it lands at the target
ships, err = origin.GetShips()
if err != nil {
    Notify("error", "nightFleetsave: could not read ships: " + err)
    return
}
oneWaySecs, _ = FlightTime(origin.GetCoordinate(), sendTo, fleetSpeed, ships, PARK, 0)
if oneWaySecs <= waitBeforeCancel + 300 {
    Notify("error", "nightFleetsave aborted: one-way flight is " + ShortDur(oneWaySecs) + " but the cancel happens after " + ShortDur(waitBeforeCancel) + ". Pick a farther target or a slower speed.")
    return
}

returnText = Pad2(Floor(returnSecondOfDay / 3600)) + ":" + Pad2(Floor((returnSecondOfDay % 3600) / 60))
Notify("info", "Total fleetsave: " + ShortDur(delta) + " | Cancel in: " + ShortDur(waitBeforeCancel) + " | One-way flight: " + ShortDur(oneWaySecs))

fleet = NewFleet()
fleet.SetOrigin(origin)
fleet.SetDestination(sendTo)
fleet.SetSpeed(fleetSpeed)
fleet.SetMission(PARK)
fleet.SetAllResources()
fleet.SetAllShips()
fleet, err = fleet.SendNow()
if err != nil {
    Notify("error", "Error sending fleetsave: " + err)
    return
}
Notify("report", "🚀 FleetSave sent from " + origin.GetCoordinate() + ". Back tomorrow around " + returnText + ". Cancel in " + ShortDur(waitBeforeCancel))

Sleep(waitBeforeCancel * 1000)

err = CancelFleet(fleet.ID)
if err != nil {
    Notify("error", "Could not cancel the fleetsave: " + err + ". Check the fleet manually!")
    return
}
Notify("report", "🛑 Fleet canceled. Back tomorrow around " + returnText)

// Log out while the fleet returns (human-like)
Sleep(Random(3000, 8000))
Logout()
Sleep(Random(waitBeforeCancel * 800, waitBeforeCancel * 900))
Login()
Notify("report", "✅ Logged in again. I'm back.")
