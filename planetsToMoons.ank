//////////////////////////////////////
// SETTINGS

// Sends all ships and resources from each planet up to its moon (Park)

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

Notify("report", "🚀 Planets ➡️ Moons started")

// Positions that have a moon ("galaxy:system:position")
moonPositions = {}
for moon in GetCachedMoons() {
    c = moon.Coordinate
    moonPositions["" + c.Galaxy + ":" + c.System + ":" + c.Position] = true
}

// Simulate initial planning time
Sleep(Random(3000, 7000))

sent = 0
failed = 0
for planet in GetCachedPlanets() {
    origin = planet.Coordinate
    if moonPositions["" + origin.Galaxy + ":" + origin.System + ":" + origin.Position] != true {
        Notify("info", "No moon at " + origin + ", skipping")
        continue
    }
    destination = NewCoordinate(origin.Galaxy, origin.System, origin.Position, MOON_TYPE)

    Sleep(Random(1500, 3000))  // Human analysis time

    fleet = NewFleet()
    fleet.SetOrigin(origin)
    fleet.SetDestination(destination)
    fleet.SetMission(PARK)
    fleet.SetAllShips()
    fleet.SetAllResources()

    Sleep(Random(2000, 4000))  // Decision delay

    fleet, err = fleet.SendNow()

    if err != nil {
        failed = failed + 1
        Notify("error", "🪐 " + origin + " ➡️ 🌙 " + destination + " failed: " + err)
        Sleep(Random(1000, 2000))
    } else {
        sent = sent + 1
        Notify("info", "🪐 " + origin + " ➡️ 🌙 " + destination + " ::: all ships + resources")
        Sleep(Random(8000, 18000))  // Human delay after sending
    }

    // Random block delay
    if Random(1, 100) > 85 {
        Sleep(Random(10000, 25000))
    }
}

Notify("report", "🏁 Planets ➡️ Moons done. Sent: " + sent + " | Failed: " + failed)
