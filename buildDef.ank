//////////////////////////////////////
// SETTINGS

// One factor per planet, in the same order as your planet list in the browser (top to bottom).
// Desired amount on a planet = value below * factor. Factor 0 = no defense on that planet.
// NOTE: if you reorder your planets in the game, reorder this list too.
factors = [10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10]

rocket_launcher_desired = 1500
light_laser_desired = 400
heavy_laser_desired = 100
gauss_cannon_desired = 50
ion_cannon_desired = 50
plasma_desired = 50
anti_balistic_desired = 20

checkInterval = 30 // minutes between checks

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

//////////////////////////////////////
// MAIN

// Queue the missing amount of one defense type
func Ensure(celestial, defenseID, have, desired) {
    desired = Round(desired)
    if have < desired {
        celestial.Build(defenseID, desired - have)
    }
}

Notify("report", "buildDef started, checking every " + checkInterval + " min")

for {
    // Read planets every cycle; a new colony without a factor stops the script
    planets = GetPlanets()
    if len(factors) < len(planets) {
        Notify("error", "buildDef stopped: " + len(factors) + " factors for " + len(planets) + " planets. Add a factor for every planet.")
        break
    }

    for i = 0; i < len(planets); i++ {
        planet = planets[i]
        f = factors[i]
        if f == 0 {
            continue
        }

        // Only queue when the shipyard is free
        productionLine = GetProduction(planet.ID)[0]
        if len(productionLine) != 0 {
            continue
        }

        celestial = GetCachedCelestial(planet.Coordinate)
        d, err = celestial.GetDefense()
        if err != nil {
            Notify("error", "Could not read defense on " + planet.Coordinate + ": " + err)
            continue
        }

        Ensure(celestial, ROCKETLAUNCHER, d.RocketLauncher, rocket_launcher_desired * f)
        Ensure(celestial, LIGHTLASER, d.LightLaser, light_laser_desired * f)
        Ensure(celestial, HEAVYLASER, d.HeavyLaser, heavy_laser_desired * f)
        Ensure(celestial, GAUSSCANNON, d.GaussCannon, gauss_cannon_desired * f)
        Ensure(celestial, IONCANNON, d.IonCannon, ion_cannon_desired * f)
        Ensure(celestial, PLASMATURRET, d.PlasmaTurret, plasma_desired * f)
        Ensure(celestial, SMALLSHIELDDOME, d.SmallShieldDome, 1)
        Ensure(celestial, LARGESHIELDDOME, d.LargeShieldDome, 1)
        Ensure(celestial, ANTIBALLISTICMISSILES, d.AntiBallisticMissiles, anti_balistic_desired * f)
        Notify("info", "Defense queued on " + planet.Coordinate)
    }
    Sleep(checkInterval * 60 * 1000)
}
