//////////////////////////////////////
// SETTINGS

lcPerPlanet = 1000          // Large Cargos to send to each planet
fleetSpeed = HUNDRED_PERCENT
minDelay = 8000             // ms between sends (min)
maxDelay = 20000            // ms between sends (max)

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

//////////////////////////////////////
// MAIN

home = GetHomeWorld()
homeShips, err = GetCachedCelestial(home.Coordinate).GetShips()
if err != nil {
    Notify("error", "homeworldToPlanets: could not read homeworld ships: " + err)
    return
}
available = homeShips.LargeCargo

Notify("report", "🚀 Homeworld ➡️ Planets started. " + lcPerPlanet + " LC per planet, " + available + " LC on " + home.Coordinate)

sent = 0
failed = 0
for planet in GetCachedPlanets() {
    if planet.GetID() == home.GetID() {
        continue
    }
    if available < lcPerPlanet {
        Notify("warn", "Not enough LC left (" + available + "), stopping before " + planet.Coordinate)
        break
    }

    fleet = NewFleet()
    fleet.SetOrigin(home.Coordinate)
    fleet.SetDestination(planet.Coordinate)
    fleet.SetSpeed(fleetSpeed)
    fleet.SetMission(PARK)
    fleet.AddShips(LARGECARGO, lcPerPlanet)
    fleet, err = fleet.SendNow()

    if err != nil {
        failed = failed + 1
        Notify("error", "" + home.Coordinate + " ➡️ " + planet.Coordinate + " failed: " + err)
        Sleep(Random(2000, 5000))
        continue
    }

    available = available - lcPerPlanet
    sent = sent + 1
    Notify("info", "" + lcPerPlanet + " LC ➡️ " + planet.Coordinate)

    Sleep(Random(minDelay, maxDelay))
    if Random(1, 100) > 85 {
        Sleep(Random(10000, 25000))
    }
}

Notify("report", "🏁 Homeworld ➡️ Planets done. Sent: " + sent + " | Failed: " + failed + " | LC left on homeworld: " + available)
