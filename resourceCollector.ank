//////////////////////////////////////
// SETTINGS

collectTo = GetHomeWorld()      // where resources go (or "M:1:2:3")
minTotalToCollect = 5000000     // only collect from planets with at least this much (M + C + D)
keepDeuterium = 200000          // deuterium left on each planet (fuel for other scripts)
lcCapacity = 25000              // cargo per Large Cargo; raise it for your Hyperspace Technology level
fleetSpeed = HUNDRED_PERCENT
checkMinMinutes = 60            // minutes between rounds
checkMaxMinutes = 90
minDelay = 8000                 // ms between sends
maxDelay = 20000

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

//////////////////////////////////////
// MAIN

target = GetCachedCelestial(collectTo)
if target == nil {
    Notify("error", "resourceCollector: " + collectTo + " is not one of your planets/moons")
    return
}
targetCoord = target.GetCoordinate()

// Returns the amount sent (M + C + D), 0 when nothing was sent
func CollectFrom(planet) {
    origin = planet.Coordinate
    celestial = GetCachedCelestial(origin)
    res, err = celestial.GetResources()
    if err != nil {
        Notify("error", "Could not read resources on " + origin + ": " + err)
        return 0
    }
    deut = res.Deuterium - keepDeuterium
    if deut < 0 {
        deut = 0
    }
    total = res.Metal + res.Crystal + deut
    if total < minTotalToCollect {
        return 0
    }

    ships, err = celestial.GetShips()
    if err != nil {
        Notify("error", "Could not read ships on " + origin + ": " + err)
        return 0
    }
    needed = int((total + lcCapacity - 1) / lcCapacity)
    lc = ships.LargeCargo
    if lc == 0 {
        Notify("warn", origin + " has " + Dotify(total) + " resources but no Large Cargos")
        return 0
    }
    if lc > needed {
        lc = needed
    }

    // Fill the cargos: metal first, then crystal, then deuterium
    space = lc * lcCapacity
    m = res.Metal
    if m > space { m = space }
    space = space - m
    c = res.Crystal
    if c > space { c = space }
    space = space - c
    d = deut
    if d > space { d = space }

    fleet = NewFleet()
    fleet.SetOrigin(origin)
    fleet.SetDestination(targetCoord)
    fleet.SetSpeed(fleetSpeed)
    fleet.SetMission(TRANSPORT)
    fleet.AddShips(LARGECARGO, lc)
    fleet.SetResources(NewResources(m, c, d))
    fleet, err = fleet.SendNow()
    if err != nil {
        Notify("error", origin + " ➡️ " + targetCoord + " failed: " + err)
        return 0
    }
    Notify("info", origin + " ➡️ " + targetCoord + " ::: " + lc + " LC | M " + Dotify(m) + " | C " + Dotify(c) + " | D " + Dotify(d))
    return m + c + d
}

Notify("report", "💰 resourceCollector started ➡️ " + targetCoord + " (min " + Dotify(minTotalToCollect) + " per planet)")

for {
    sent = 0
    amount = 0
    for planet in GetPlanets() {
        if planet.Coordinate.Galaxy == targetCoord.Galaxy && planet.Coordinate.System == targetCoord.System && planet.Coordinate.Position == targetCoord.Position {
            continue
        }
        got = CollectFrom(planet)
        if got > 0 {
            sent = sent + 1
            amount = amount + got
            Sleep(Random(minDelay, maxDelay))
        }
    }
    if sent > 0 {
        Notify("report", "💰 Collected " + Dotify(amount) + " resources from " + sent + " planets")
    }
    Sleep(Random(checkMinMinutes, checkMaxMinutes) * 60 * 1000)
}
