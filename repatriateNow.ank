//////////////////////////////////////
// SETTINGS

arrivalWaitMinutes = 5   // extra wait after moonsToPlanets so its fleets land before planetsToMoons

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

//////////////////////////////////////
// MAIN

// Start a script and wait for it to finish (checks every 5 min)
func StartAndWait(scriptName) {
    Notify("info", "Starting " + scriptName)
    StartScript(scriptName)
    Sleep(5*60*1000)
    for IsScriptRunning(scriptName) == true {
        Sleep(5*60*1000)
    }
}

Notify("report", "🔁 Repatriate started")
StartAndWait("moonsToPlanets.ank")
// The script ends right after the last send; give those fleets time to arrive
Sleep(arrivalWaitMinutes * 60 * 1000)
StartAndWait("planetsToMoons.ank")
RepatriateNow()
Notify("report", "🔁 Repatriate done")
