//////////////////////////////////////
// SETTINGS

// Ships to keep on each moon; the rest is parked on the homeworld
SC = 3500
LC = 2000

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

//////////////////////////////////////
// MAIN

// Sends the extra cargos from a moon to the homeworld. Returns "sent", "skipped" or "failed"
func TransferShipsFromMoon(moon, scToKeep, lcToKeep) {
    origin = moon.Coordinate
    allShips, err = GetCachedCelestial(origin).GetShips()
    if err != nil {
        Notify("error", "" + origin + " could not read ships: " + err)
        return "failed"
    }

    largeToSend = allShips.LargeCargo - lcToKeep
    smallToSend = allShips.SmallCargo - scToKeep
    if largeToSend <= 0 && smallToSend <= 0 {
        return "skipped"
    }

    destination = GetHomeWorld()
    fleet = NewFleet()
    fleet.SetOrigin(origin)
    fleet.SetDestination(destination)
    fleet.SetMission(PARK)
    if largeToSend > 0 {
        fleet.AddShips(LARGECARGO, largeToSend)
    }
    if smallToSend > 0 {
        fleet.AddShips(SMALLCARGO, smallToSend)
    }
    fleet, err = fleet.SendNow()
    if err != nil {
        Notify("error", "" + origin + " ➡️ homeworld failed: " + err)
        Sleep(Random(1000, 3000))
        return "failed"
    }
    Notify("info", "" + origin + " ➡️ " + destination.Coordinate + " ::: LC " + largeToSend + " | SC " + smallToSend)
    Sleep(Random(1000, 5000))
    return "sent"
}

sent = 0
failed = 0
for moon in GetCachedMoons() {
    result = TransferShipsFromMoon(moon, SC, LC)
    if result == "sent" {
        sent = sent + 1
    } else if result == "failed" {
        failed = failed + 1
    }
}

Notify("report", "🚚 Moons ➡️ Homeworld done. Transports: " + sent + " | Failed: " + failed)
