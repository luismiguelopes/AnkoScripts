//////////////////////////////////////
// SETTINGS

// Fleetsave with the Colonize mission: the colony ship reaches a slot where colonizing fails
// and the whole fleet flies straight back, so the trip home takes as long as the trip out.
// The script picks, per moon, the destination (distance) and the speed so that every fleet
// lands back home at one common time: away time = 2 x one-way flight.
// Origins are sent in ascending coordinates.
// ⚠️ The target slot must NOT be colonizable (occupied, or position 1/15 without Astrophysics 8),
// otherwise the colony ship really colonizes it.

includeMoons = true
includePlanets = false
targetPositions = [1, 15]       // planet positions the fleets may be sent to (1 and 15 need Astrophysics 8 to colonize)
maxDestinationTries = 6         // when a destination is refused (e.g. player in vacation mode), try this many others:
                                // the other targetPositions in the same system first, then the systems next to it

// Return time: one common time is picked at random between returnFromHour and returnToHour
// (server time, the next window at least 1h away) and every fleet aims for it +/- returnSpread minutes.
returnFromHour = 10
returnToHour = 11
returnSpread = 5                // minutes
timezoneOffsetHours = 1         // server time minus UTC

// Search space
numGalaxies = 5
numSystems = 499
maxSystemOffset = 250           // systems away in the same galaxy (both directions)
allowOtherGalaxies = true       // also try the same system in other galaxies (long trips)
generalClass = false            // true: 5% speed steps (General), false: 10% steps
toleranceMinutes = 3            // landings within this of the target count as "on time"; the cheapest speed among them wins
warnMinutes = 15                // report a warning when the best landing is further off than this
departureLagSecs = 8            // SendNow waits 7-9 s after the previous departure

minDelay = 5000                 // ms between sends
maxDelay = 20000

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

// Count of one ship type in a ShipsInfos
func ShipCount(allShips, shipType) {
    if shipType == LIGHTFIGHTER { return allShips.LightFighter }
    if shipType == HEAVYFIGHTER { return allShips.HeavyFighter }
    if shipType == CRUISER { return allShips.Cruiser }
    if shipType == BATTLESHIP { return allShips.Battleship }
    if shipType == SMALLCARGO { return allShips.SmallCargo }
    if shipType == LARGECARGO { return allShips.LargeCargo }
    if shipType == COLONYSHIP { return allShips.ColonyShip }
    if shipType == BATTLECRUISER { return allShips.Battlecruiser }
    if shipType == BOMBER { return allShips.Bomber }
    if shipType == DESTROYER { return allShips.Destroyer }
    if shipType == DEATHSTAR { return allShips.Deathstar }
    if shipType == RECYCLER { return allShips.Recycler }
    if shipType == ESPIONAGEPROBE { return allShips.EspionageProbe }
    if shipType == REAPER { return allShips.Reaper }
    if shipType == PATHFINDER { return allShips.Pathfinder }
    return 0
}

// Adds every flying ship explicitly (SetAllShips() is undocumented and the cargo must count every ship)
func AddAllShips(fleet, ships) {
    for t in [LIGHTFIGHTER, HEAVYFIGHTER, CRUISER, BATTLESHIP, BATTLECRUISER, BOMBER, DESTROYER, DEATHSTAR, SMALLCARGO, LARGECARGO, COLONYSHIP, RECYCLER, ESPIONAGEPROBE, REAPER, PATHFINDER] {
        n = ShipCount(ships, t)
        if n > 0 {
            fleet.AddShips(t, n)
        }
    }
}

// Loads as much as the cargo holds: deuterium first, then crystal, then metal.
// Replaces SetAllResources(), which left the fleets empty. Call it after the ships are added.
// The flight's fuel stays on the celestial and its space is kept free in the cargo.
// ships: a ShipsInfos with exactly the ships in the fleet (Cargo() does not accept the fleet builder).
// Returns the total loaded (0 on error, the fleet still leaves with its ships).
func LoadAllResources(fleet, celestial, ships) {
    res, err = celestial.GetResources()
    if err != nil {
        Notify("warn", "" + celestial.GetCoordinate() + ": could not read resources, fleet leaves empty: " + err)
        return 0
    }
    _, fuel = fleet.FlightTime()
    space = -1
    try {
        space = Cargo(ships) - fuel
    } catch e {
        Notify("warn", "Cargo() failed (" + e + "), falling back to SetAllResources")
        fleet.SetAllResources()
        return 0
    }
    if space < 0 { space = 0 }
    d = res.Deuterium - fuel
    if d < 0 { d = 0 }
    if d > space { d = space }
    space = space - d
    c = res.Crystal
    if c > space { c = space }
    space = space - c
    m = res.Metal
    if m > space { m = space }
    fleet.SetResources(NewResources(Floor(m), Floor(c), Floor(d)))
    return Floor(m) + Floor(c) + Floor(d)
}

//////////////////////////////////////
// MAIN

func Pad2(n) {
    if n < 10 {
        return "0" + n
    }
    return "" + n
}

// "HH:MM" (server time) of a timestamp
func HourText(ts) {
    secOfDay = (ts + timezoneOffsetHours * 3600) % 86400
    return Pad2(Floor(secOfDay / 3600)) + ":" + Pad2(Floor((secOfDay % 3600) / 60))
}

// "+3m" / "-1m" / "0m"
func DiffText(secs) {
    m = Round(secs / 60)
    if m > 0 {
        return "+" + m + "m"
    }
    return "" + m + "m"
}

func Wrap(n, size) {
    return ((n - 1) % size + size) % size + 1
}

// Speeds the account can use (10 = 100%), slowest first
func SpeedList() {
    list = []
    if generalClass {
        for i = 1; i <= 20; i++ {
            list += i * 0.5
        }
    } else {
        for i = 1; i <= 10; i++ {
            list += i
        }
    }
    return list
}

// Destinations refused by the game (vacation mode, ...), shared by every origin: "g:s:p" -> true
badDestinations = {}

func CoordKey(g, sys, pos) {
    return "" + g + ":" + sys + ":" + pos
}

func IsUsable(origin, g, sys, pos) {
    if g == origin.Galaxy && sys == origin.System && pos == origin.Position {
        return false
    }
    return badDestinations[CoordKey(g, sys, pos)] != true
}

// Every destination the fleet may aim for, with its distance (Distance() makes no request)
func Candidates(origin) {
    list = []
    for k = -maxSystemOffset; k <= maxSystemOffset; k++ {
        sys = Wrap(origin.System + k, numSystems)
        for pos in targetPositions {
            if IsUsable(origin, origin.Galaxy, sys, pos) {
                dest = NewCoordinate(origin.Galaxy, sys, pos, PLANET_TYPE)
                list += [[dest, Distance(origin, dest)]]
            }
        }
    }
    if allowOtherGalaxies {
        for dg = 1; dg <= Floor(numGalaxies / 2); dg++ {
            for sign in [1, -1] {
                g = Wrap(origin.Galaxy + sign * dg, numGalaxies)
                if g == origin.Galaxy {
                    continue
                }
                for pos in targetPositions {
                    if IsUsable(origin, g, origin.System, pos) {
                        dest = NewCoordinate(g, origin.System, pos, PLANET_TYPE)
                        list += [[dest, Distance(origin, dest)]]
                    }
                }
            }
        }
    }
    return list
}

// Real FlightTime of one route at every speed (one request at most): the speed landing closest
// to returnAt, the slowest one when several are within tolerance. [dest, speed, oneWaySecs, fuel, errSecs] or nil
func BestSpeed(origin, dest, ships, returnAt) {
    tolerance = toleranceMinutes * 60
    away = returnAt - GetTimestamp() - departureLagSecs
    best = nil
    for s in SpeedList() {
        real, fuel = FlightTime(origin, dest, s, ships, COLONIZE)
        if real <= 0 { continue }
        e = Abs(2 * real - away)
        // speeds go slowest first: once one is within tolerance, keep it (cheapest)
        if best == nil || (best[4] > tolerance && e < best[4]) {
            best = [dest, s, real, fuel, e]
        }
    }
    return best
}

// Replacements for a refused destination, nearest first: the other targetPositions in its system,
// then the same positions in the systems next to it (+1, -1, +2, -2, ...). At most `count`.
func Alternatives(origin, refused, count) {
    list = []
    for d = 0; d <= maxSystemOffset && len(list) < count; d++ {
        offsets = [d, -d]
        if d == 0 { offsets = [0] }
        for off in offsets {
            sys = Wrap(refused.System + off, numSystems)
            for pos in targetPositions {
                if len(list) < count && IsUsable(origin, refused.Galaxy, sys, pos) {
                    list += NewCoordinate(refused.Galaxy, sys, pos, PLANET_TYPE)
                }
            }
        }
    }
    return list
}

// Picks the route and speed whose return lands closest to returnAt.
// OGame flight time is t = a + B * sqrt(distance) / speed, so two FlightTime calls on one route
// (one request at most) give a and B; the model then ranks every candidate without requests.
// The pick is checked with the real FlightTime and the model is corrected (up to 3 rounds),
// because universes that skip empty systems shorten real distances.
// Returns [dest, speed, oneWaySecs, fuel, errSecs] or nil.
func PlanRoute(origin, ships, returnAt) {
    ref = NewCoordinate(origin.Galaxy, Wrap(origin.System + 1, numSystems), targetPositions[0], PLANET_TYPE)
    t100, _ = FlightTime(origin, ref, HUNDRED_PERCENT, ships, COLONIZE)
    t10, _ = FlightTime(origin, ref, TEN_PERCENT, ships, COLONIZE)
    if t100 <= 0 || t10 <= t100 {
        Notify("warn", "" + origin + ": FlightTime gave " + t10 + "/" + t100 + " s, cannot plan the return")
        return nil
    }
    B = (t10 - t100) * 10 / 9
    a = t10 - B
    if a < 0 { a = 0 }
    k = B / Sqrt(Distance(origin, ref))

    speeds = SpeedList()
    cands = Candidates(origin)
    if len(cands) == 0 {
        Notify("warn", "" + origin + ": no usable destination left")
        return nil
    }
    tolerance = toleranceMinutes * 60
    corr = 1.0
    best = nil
    for iter = 0; iter < 3; iter++ {
        departAt = GetTimestamp() + departureLagSecs
        oneWay = (returnAt - departAt) / 2

        // Model: best error, then the slowest speed within tolerance (fuel grows with speed)
        minErr = -1
        for c in cands {
            for s in speeds {
                e = Abs(a + corr * k * Sqrt(c[1]) / s - oneWay)
                if minErr < 0 || e < minErr { minErr = e }
            }
        }
        limit = minErr
        if limit < tolerance / 2 { limit = tolerance / 2 }
        pickSpeed = -1
        picks = []
        for s in speeds {
            for c in cands {
                e = Abs(a + corr * k * Sqrt(c[1]) / s - oneWay)
                if e <= limit {
                    if pickSpeed < 0 { pickSpeed = s }
                    if s == pickSpeed { picks += [c] }
                }
            }
            if pickSpeed >= 0 { break }
        }
        pick = picks[Random(0, len(picks) - 1)]
        predicted = a + corr * k * Sqrt(pick[1]) / pickSpeed

        // Real check on the picked route, then correct the model with it
        r = BestSpeed(origin, pick[0], ships, returnAt)
        if r != nil && (best == nil || r[4] < best[4]) {
            best = r
        }
        real, _ = FlightTime(origin, pick[0], pickSpeed, ships, COLONIZE)
        if real > 0 && predicted - a > 0 {
            corr = corr * (real - a) / (predicted - a)
        }
        if best != nil && best[4] <= tolerance {
            break
        }
    }
    return best
}

// Returns [result, line]: result is "sent", "skipped" or "failed", line the summary line
func FleetSave(origin, returnAt) {
    // The Colonize mission needs at least one colony ship in the fleet
    ships, err = GetCachedCelestial(origin).GetShips()
    if err != nil {
        Notify("error", "" + origin + " could not read ships: " + err)
        return ["failed", ""]
    }
    if ships.ColonyShip == 0 {
        Notify("warn", "" + origin + " skipped: no colony ship here")
        return ["skipped", ""]
    }

    Sleep(Random(1500, 4000))       // "checking the fleet screen"
    plan = PlanRoute(origin, ships, returnAt)
    if plan == nil {
        return ["failed", ""]
    }

    // Send; if the game refuses the destination, mark it bad and try the nearest alternatives
    alternatives = []
    tries = 0
    sentOk = false
    for !sentOk {
        dest = plan[0]
        speed = plan[1]
        oneWay = plan[2]
        fleet = NewFleet()
        fleet.SetOrigin(origin)
        fleet.SetDestination(dest)
        fleet.SetSpeed(speed)
        fleet.SetMission(COLONIZE)
        AddAllShips(fleet, ships)
        LoadAllResources(fleet, GetCachedCelestial(origin), ships)
        fleet, err = fleet.SendNow()
        if err == nil {
            sentOk = true
            break
        }
        badDestinations[CoordKey(dest.Galaxy, dest.System, dest.Position)] = true
        if tries == 0 {
            alternatives = Alternatives(origin, dest, maxDestinationTries)
        }
        // next alternative that is still usable (another origin may have found it bad meanwhile)
        plan = nil
        for plan == nil && tries < len(alternatives) {
            alt = alternatives[tries]
            tries = tries + 1
            if IsUsable(origin, alt.Galaxy, alt.System, alt.Position) {
                plan = BestSpeed(origin, alt, ships, returnAt)
            }
        }
        if plan == nil {
            Notify("error", "" + origin + " fleetsave failed (" + tries + " other destinations tried): " + err)
            return ["failed", ""]
        }
        Notify("info", "" + origin + " ➡️ " + dest + " refused (" + err + "), trying " + plan[0])
        Sleep(Random(2000, 5000))
    }

    backAt = GetTimestamp() + 2 * oneWay
    line = "" + origin + " ➡️ " + dest + " @" + (speed * 10) + "% (" + ShortDur(oneWay) + " x2) | back " + HourText(backAt) + " (" + DiffText(backAt - returnAt) + ")"
    if Abs(backAt - returnAt) > warnMinutes * 60 {
        Notify("warn", "⚠️ " + line + " — no route lands closer")
    } else {
        Notify("info", line)
    }
    return ["sent", line]
}

func OriginKey(c) {
    return c.Galaxy * 100000 + c.System * 100 + c.Position
}

// Next return window: today if it is still at least 1h away, otherwise tomorrow
year, month, day = Date()
dayStart = Unix(0, 0).AddDate(year - 1970, month - 1, day - 1).Unix()
windowStart = dayStart + returnFromHour * 3600 - timezoneOffsetHours * 3600
if windowStart < GetTimestamp() + 3600 {
    windowStart = windowStart + 24 * 3600
}
windowEnd = windowStart + (returnToHour - returnFromHour) * 3600
returnTarget = Random(windowStart, windowEnd)

origins = []
if includeMoons {
    for m in GetCachedMoons() {
        origins += m.Coordinate
    }
}
if includePlanets {
    for p in GetCachedPlanets() {
        origins += p.Coordinate
    }
}
// ascending coordinates: galaxy, system, position (insertion sort; a moon stays before its planet)
for i = 1; i < len(origins); i++ {
    j = i
    for j > 0 && OriginKey(origins[j-1]) > OriginKey(origins[j]) {
        tmp = origins[j-1]
        origins[j-1] = origins[j]
        origins[j] = tmp
        j = j - 1
    }
}

Notify("report", "🛡️ FleetSave On Colonize started: " + len(origins) + " origins, all back ~" + HourText(returnTarget) + " (+/-" + returnSpread + " min)")

sent = 0
failed = 0
skipped = 0
summary = []
for origin in origins {
    returnAt = returnTarget + Random(-returnSpread * 60, returnSpread * 60)
    out = FleetSave(origin, returnAt)
    result = out[0]
    if result == "sent" {
        summary += out[1]
        sent = sent + 1
    } else if result == "failed" {
        failed = failed + 1
    } else {
        skipped = skipped + 1
    }
    Sleep(Random(minDelay, maxDelay))
}

report = "🛡️ FleetSave On Colonize done. Sent: " + sent + " | Skipped: " + skipped + " | Failed: " + failed
for line in summary {
    report = report + "\n" + line
}
Notify("report", report)
