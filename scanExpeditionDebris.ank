//////////////////////////////////////
// SETTINGS

galaxy = 5
minSystem = 1
maxSystem = 499
minPathfinders = 70     // report fields that need more pathfinders than this

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

Notify("info", "Scanning expedition debris in G" + galaxy + " " + minSystem + "-" + maxSystem)

found = []
errors = 0
for system = minSystem; system <= maxSystem; system++ {
    systemInfos, err = GalaxyInfos(galaxy, system)
    if err != nil {
        errors = errors + 1
        LogError(err)
    } else {
        debris = systemInfos.ExpeditionDebris
        if debris.PathfindersNeeded > minPathfinders {
            line = "" + galaxy + ":" + system + " | M " + Dotify(debris.Metal) + " | C " + Dotify(debris.Crystal) + " | PF " + debris.PathfindersNeeded
            Notify("info", line)
            found += line
        }
    }
    Sleep(Random(500, 2000))
}

// One Telegram message with every field found
report = "🛰️ Expedition debris G" + galaxy + ": " + len(found) + " fields with > " + minPathfinders + " PF"
for line in found {
    report = report + "\n" + line
}
if errors > 0 {
    report = report + "\n⚠️ " + errors + " systems could not be read"
}
Notify("report", report)
