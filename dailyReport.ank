//////////////////////////////////////
// SETTINGS

reportHour = 8                  // server time; report is sent between reportHour and +15 min
timezoneOffsetHours = 1         // server time minus UTC
sendFirstReportNow = true       // also send one report right after starting
includeMoons = true             // list moons in the resources section

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

shipTypes = [LIGHTFIGHTER, HEAVYFIGHTER, CRUISER, BATTLESHIP, BATTLECRUISER, BOMBER, DESTROYER, DEATHSTAR, REAPER, PATHFINDER, SMALLCARGO, LARGECARGO, COLONYSHIP, RECYCLER, ESPIONAGEPROBE]
shipNames = ["LF", "HF", "Cruiser", "BS", "BC", "Bomber", "Destroyer", "RIP", "Reaper", "PF", "SC", "LC", "Colony", "Recycler", "Probe"]

// Amount of a ship type in a ShipsInfos
func ShipCount(allShips, shipType) {
    if shipType == LIGHTFIGHTER { return allShips.LightFighter }
    if shipType == HEAVYFIGHTER { return allShips.HeavyFighter }
    if shipType == CRUISER { return allShips.Cruiser }
    if shipType == BATTLESHIP { return allShips.Battleship }
    if shipType == SMALLCARGO { return allShips.SmallCargo }
    if shipType == LARGECARGO { return allShips.LargeCargo }
    if shipType == COLONYSHIP { return allShips.ColonyShip }
    if shipType == BATTLECRUISER { return allShips.Battlecruiser }
    if shipType == BOMBER { return allShips.Bomber }
    if shipType == DESTROYER { return allShips.Destroyer }
    if shipType == DEATHSTAR { return allShips.Deathstar }
    if shipType == RECYCLER { return allShips.Recycler }
    if shipType == ESPIONAGEPROBE { return allShips.EspionageProbe }
    if shipType == REAPER { return allShips.Reaper }
    if shipType == PATHFINDER { return allShips.Pathfinder }
    return 0
}

// Signed difference, e.g. "+1.234" / "-56"
func Delta(now, before) {
    d = now - before
    if d >= 0 {
        return "+" + Dotify(d)
    }
    return "-" + Dotify(-d)
}

// Seconds until the next report time
func SecondsUntilNextReport() {
    year, month, day = Date()
    now = GetTimestamp()
    t = Unix(0, 0).AddDate(year - 1970, month - 1, day - 1)     // today 00:00 UTC
    at = t.Unix() + reportHour * 3600 - timezoneOffsetHours * 3600 + Random(0, 900)
    if at <= now {
        at = at + 24 * 3600
    }
    return at - now
}

lastPoints = -1
lastRank = -1

func BuildReport() {
    lines = ["📊 Daily report"]

    // --- Player ---
    player = GetCachedPlayer()
    playerLine = "🏅 Points " + Dotify(player.Points) + " | Rank " + player.Rank
    if lastPoints >= 0 {
        // Rank going down is good, so show it as "+N places"
        playerLine = playerLine + "\n    since yesterday: points " + Delta(player.Points, lastPoints) + " | places " + Delta(lastRank, player.Rank)
    }
    lines += playerLine
    lastPoints = player.Points
    lastRank = player.Rank

    // --- Resources and fleet ---
    celestials = []
    for p in GetCachedPlanets() {
        celestials += p
    }
    if includeMoons {
        for m in GetCachedMoons() {
            celestials += m
        }
    }

    totalM = 0
    totalC = 0
    totalD = 0
    fleet = []
    for i = 0; i < len(shipTypes); i++ {
        fleet += 0
    }
    resourceLines = []
    errors = 0

    for c in celestials {
        celestial = GetCachedCelestial(c.Coordinate)
        res, err = celestial.GetResources()
        if err != nil {
            errors = errors + 1
        } else {
            totalM = totalM + res.Metal
            totalC = totalC + res.Crystal
            totalD = totalD + res.Deuterium
            resourceLines += "    " + c.Coordinate + " M " + Dotify(res.Metal) + " | C " + Dotify(res.Crystal) + " | D " + Dotify(res.Deuterium)
        }

        ships, err = celestial.GetShips()
        if err != nil {
            errors = errors + 1
        } else {
            for i = 0; i < len(shipTypes); i++ {
                fleet[i] = fleet[i] + ShipCount(ships, shipTypes[i])
            }
        }
        Sleep(Random(300, 1200))
    }

    lines += "💰 Total M " + Dotify(totalM) + " | C " + Dotify(totalC) + " | D " + Dotify(totalD)
    for l in resourceLines {
        lines += l
    }

    fleetLine = "🚀 Fleet (on planets/moons):"
    for i = 0; i < len(shipTypes); i++ {
        if fleet[i] > 0 {
            fleetLine = fleetLine + " " + shipNames[i] + " " + Dotify(fleet[i]) + ","
        }
    }
    lines += fleetLine

    // --- Slots ---
    slots = GetSlots()
    if slots != nil {
        lines += "🛰️ Slots " + slots.InUse + "/" + slots.Total + " | Expeditions " + slots.ExpInUse + "/" + slots.ExpTotal
    }

    // --- Attacks ---
    underAttack, err = IsUnderAttack()
    if err == nil && underAttack {
        lines += "⚠️ You are under attack right now!"
    }

    if errors > 0 {
        lines += "⚠️ " + errors + " reads failed"
    }

    report = ""
    for l in lines {
        report = report + l + "\n"
    }
    return report
}

Notify("info", "dailyReport started, report every day at " + reportHour + "h")
if sendFirstReportNow {
    Notify("report", BuildReport())
}
for {
    wait = SecondsUntilNextReport()
    Notify("info", "Next daily report in " + ShortDur(wait))
    Sleep(wait * 1000)
    Notify("report", BuildReport())
}
