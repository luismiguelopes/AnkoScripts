//////////////////////////////////////
// SETTINGS

lcToSend = 0                // Large Cargos to bring back from each planet (0 = all of them)
fleetSpeed = HUNDRED_PERCENT
minDelay = 8000             // ms between sends (min)
maxDelay = 20000            // ms between sends (max)

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

// Loads as much as the cargo holds: deuterium first, then crystal, then metal.
// Replaces SetAllResources(), which left the fleets empty. Call it after the ships are added.
// The flight's fuel stays on the celestial and its space is kept free in the cargo.
// ships: a ShipsInfos with exactly the ships in the fleet (Cargo() does not accept the fleet builder).
// Returns the total loaded (0 on error, the fleet still leaves with its ships).
func LoadAllResources(fleet, celestial, ships) {
    res, err = celestial.GetResources()
    if err != nil {
        Notify("warn", "" + celestial.GetCoordinate() + ": could not read resources, fleet leaves empty: " + err)
        return 0
    }
    _, fuel = fleet.FlightTime()
    space = -1
    try {
        space = Cargo(ships) - fuel
    } catch e {
        Notify("warn", "Cargo() failed (" + e + "), falling back to SetAllResources")
        fleet.SetAllResources()
        return 0
    }
    if space < 0 { space = 0 }
    d = res.Deuterium - fuel
    if d < 0 { d = 0 }
    if d > space { d = space }
    space = space - d
    c = res.Crystal
    if c > space { c = space }
    space = space - c
    m = res.Metal
    if m > space { m = space }
    fleet.SetResources(NewResources(Floor(m), Floor(c), Floor(d)))
    return Floor(m) + Floor(c) + Floor(d)
}


home = GetHomeWorld()

lcText = "all"
if lcToSend > 0 {
    lcText = "" + lcToSend
}
Notify("report", "🚀 Planets ➡️ Homeworld started. LC per planet: " + lcText + " + all resources ➡️ " + home.Coordinate)

sent = 0
failed = 0
skipped = 0
totalLC = 0
for planet in GetCachedPlanets() {
    if planet.GetID() == home.GetID() {
        continue
    }
    origin = planet.Coordinate

    allShips, err = GetCachedCelestial(origin).GetShips()
    if err != nil {
        failed = failed + 1
        Notify("error", "Could not read ships on " + origin + ": " + err)
        continue
    }
    lc = allShips.LargeCargo
    if lcToSend > 0 && lc > lcToSend {
        lc = lcToSend
    }
    if lc == 0 {
        skipped = skipped + 1
        Notify("info", "No Large Cargos on " + origin + ", skipping")
        continue
    }

    fleet = NewFleet()
    fleet.SetOrigin(origin)
    fleet.SetDestination(home.Coordinate)
    fleet.SetSpeed(fleetSpeed)
    fleet.SetMission(PARK)
    fleet.AddShips(LARGECARGO, lc)
    lcShips = NewShipsInfos()
    lcShips.Set(LARGECARGO, lc)
    LoadAllResources(fleet, GetCachedCelestial(origin), lcShips)     // as much as the cargos can carry
    fleet, err = fleet.SendNow()

    if err != nil {
        failed = failed + 1
        Notify("error", "" + origin + " ➡️ " + home.Coordinate + " failed: " + err)
        Sleep(Random(2000, 5000))
        continue
    }

    sent = sent + 1
    totalLC = totalLC + lc
    Notify("info", "" + lc + " LC + resources " + origin + " ➡️ " + home.Coordinate)

    Sleep(Random(minDelay, maxDelay))
    if Random(1, 100) > 85 {
        Sleep(Random(10000, 25000))
    }
}

Notify("report", "🏁 Planets ➡️ Homeworld done. Sent: " + sent + " (" + totalLC + " LC) | Skipped: " + skipped + " | Failed: " + failed)
