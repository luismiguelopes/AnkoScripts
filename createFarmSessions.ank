// Creates the farm sessions every day, automatically, from your moons (or planets
// in a galaxy without moons).
// - Each origin gets the systems closest to it (circular galaxy, 499 -> 1). Areas never overlap
//   and together cover the whole galaxy.
// - The border between two origins moves a little every day, and each area is split into several
//   sessions of random size, so the ranges change from one day to the next.
// - Before creating, it deletes the sessions it created the day before (those whose name starts
//   with sessionPrefix). Sessions created by hand, or by an older version of this script, are not touched.
// - Sessions run one at a time: the new ones go to the farmer's queue in ascending order
//   (galaxy, then first system).
// - The farmer is switched off while creating, so nothing raids until farmSchedule.ank (or
//   startAfterCreate) starts it.

//////////////////////////////////////
// SETTINGS

sessionPrefix = "AutoFarm"      // name of the sessions created (and deleted) by this script
systemsPerGalaxy = 499
minChunk = 35                   // smallest session, in systems
maxChunk = 80                   // largest session, in systems
borderJitter = 12               // the border between two origins moves up to +/- this many systems

repeatDaily = true              // false = create once and stop
createHour = 5                  // server time; recreate every day between createHour and +60 min (before farmSchedule wakeUpHour)
startAfterCreate = false        // false = leave the farmer off, farmSchedule.ank starts it; true = start farming right away
timezoneOffsetHours = 1         // server time minus UTC

// Settings of every session
probes = 10
additionalCargo = 10            // percent, 0-50
minimumResourcesToAttack = 3000000
minimumPlayerRank = 0           // 0 = no limit
deleteReports = false           // true = delete the espionage and combat reports of the farm

// Waves ("majority"): the next wave leaves once this share of the raids is back, then waits
// up to this many minutes for the ones arriving just after. Picked at random for every session.
majorityMinPercent = 60
majorityMaxPercent = 80
majorityMinWait = 3             // minutes
majorityMaxWait = 12            // minutes

// Pause between two raids of a wave, in seconds (min at least 2). Picked at random for every session.
attackDelayMin = [3, 6]         // the session's minimum pause is picked between these
attackDelayMax = [10, 25]       // the session's maximum pause is picked between these

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

// Integer division for a, b >= 0 ("/" always returns a float in this Anko)
func IntDiv(a, b) {
    q = 0
    for (q + 1) * b <= a {
        q = q + 1
    }
    return q
}

// Brings any system number back into 1..systemsPerGalaxy (circular galaxy)
func Wrap(s) {
    return ((s - 1) % systemsPerGalaxy + systemsPerGalaxy) % systemsPerGalaxy + 1
}

// Origins of a galaxy, sorted by system: [[system, celestial], ...]
func OriginsOf(galaxy, celestials) {
    list = []
    for c in celestials {
        coord = c.GetCoordinate()
        if coord.Galaxy != galaxy {
            continue
        }
        // keep one origin per system
        dup = false
        for o in list {
            if o[0] == coord.System {
                dup = true
            }
        }
        if !dup {
            list += [[coord.System, c]]
        }
    }
    // insertion sort by system
    for i = 1; i < len(list); i++ {
        j = i
        for j > 0 && list[j-1][0] > list[j][0] {
            tmp = list[j-1]
            list[j-1] = list[j]
            list[j] = tmp
            j = j - 1
        }
    }
    return list
}

// Splits `length` systems starting at `start` into random chunks: [[galaxy, from, to, origin, fromMoon], ...]
func SplitArea(galaxy, start, length, origin, fromMoon) {
    chunks = []
    s = start
    remaining = length
    for remaining > 0 {
        size = Random(minChunk, maxChunk)
        if remaining - size < minChunk {
            size = remaining
        }
        chunks += [[galaxy, Wrap(s), Wrap(s + size - 1), origin, fromMoon]]
        s = s + size
        remaining = remaining - size
    }
    return chunks
}

// Sort key of a chunk: galaxy, then first system
func ChunkKey(chunk) {
    return chunk[0] * 1000 + chunk[1]
}

// Every session to create today, for every galaxy where you have a moon or a planet
func PlanSessions() {
    moons = GetCachedMoons()
    planets = GetCachedPlanets()
    maxGalaxy = 0
    for c in planets {
        if c.GetCoordinate().Galaxy > maxGalaxy {
            maxGalaxy = c.GetCoordinate().Galaxy
        }
    }
    chunks = []
    for g = 1; g <= maxGalaxy; g++ {
        origins = OriginsOf(g, moons)
        fromMoon = true
        if len(origins) == 0 {
            origins = OriginsOf(g, planets)
            fromMoon = false
        }
        n = len(origins)
        if n == 0 {
            continue
        }
        if !fromMoon {
            Notify("warn", "G" + g + ": no moon, sessions start from planets")
        }
        if n == 1 {
            chunks += SplitArea(g, Random(1, systemsPerGalaxy), systemsPerGalaxy, origins[0][1], fromMoon)
            continue
        }
        // cuts[i] = last system (not wrapped) of origin i: halfway to the next origin, moved a bit
        cuts = []
        for i = 0; i < n; i++ {
            cur = origins[i][0]
            next = origins[(i + 1) % n][0]
            gap = ((next - cur) % systemsPerGalaxy + systemsPerGalaxy) % systemsPerGalaxy
            jitter = borderJitter
            if jitter > IntDiv(gap, 4) {
                jitter = IntDiv(gap, 4)
            }
            cuts += [cur + IntDiv(gap, 2) + Random(-jitter, jitter)]
        }
        for i = 0; i < n; i++ {
            prevCut = cuts[(i + n - 1) % n]
            length = ((cuts[i] - prevCut) % systemsPerGalaxy + systemsPerGalaxy) % systemsPerGalaxy
            chunks += SplitArea(g, prevCut + 1, length, origins[i][1], fromMoon)
        }
    }
    // ascending coordinates: galaxy, then first system (insertion sort)
    for i = 1; i < len(chunks); i++ {
        j = i
        for j > 0 && ChunkKey(chunks[j-1]) > ChunkKey(chunks[j]) {
            tmp = chunks[j-1]
            chunks[j-1] = chunks[j]
            chunks[j] = tmp
            j = j - 1
        }
    }
    return chunks
}

// True if name starts with prefix (no imports in Kepler's Anko, so no strings.HasPrefix)
func StartsWith(name, prefix) {
    return len(name) >= len(prefix) && name[0:len(prefix)] == prefix
}

// Deletes the sessions created by this script (name starts with sessionPrefix)
func DeleteOldSessions() {
    deleted = 0
    try {
        for s in GetFarmSessions() {
            if StartsWith(s.Name, sessionPrefix) {
                DeleteFarmSession(s.ID)
                deleted = deleted + 1
                Sleep(Random(500, 1500))
            }
        }
    } catch e {
        Notify("warn", "Could not delete the old sessions (needs Kepler 1.82.653+): " + e)
    }
    return deleted
}

func CreateSession(chunk) {
    galaxy = chunk[0]
    from = chunk[1]
    to = chunk[2]
    origin = chunk[3]
    name = sessionPrefix + " G" + galaxy + " " + from + "-" + to
    s = NewFarmSession()
    s.SetName(name)
    s.SetOrigin(origin)
    s.SetRange(galaxy, from, to)
    s.SetProbes(probes)
    s.SetAdditionalCargo(additionalCargo)
    s.SetMinimumResourcesToAttack(minimumResourcesToAttack)
    // Only targets with no defense: Kepler accepts a target whose seen defense is strictly below n
    s.SetMinimumDefensesToIgnore(1)
    s.SetAttackPlayersWithDefenses(false)
    s.SetMinimumStorageToIgnore(5, 5, 5)
    s.SetMinimumPlayerRank(minimumPlayerRank)
    s.SetEspionageProbeRaids(false)
    // Raid ships: pathfinders first, then small cargos when they run short, then large cargos
    // (a raid never mixes two types)
    s.SetUsePathfinders(true)
    s.SetSmallCargosFirst(false)
    s.SetBackupCargos(SMALLCARGO, LARGECARGO)
    // Probes and raids leave from the origin of this session, never from the nearest celestial
    // (in Kepler both flags are the same mode, so both are set to false)
    s.SetAttackFromNearestPlanet(false)
    s.SetAttackFromNearestMoon(false)
    // Waves: no SetFastAttacking here, it would overwrite the strategy
    s.SetFarmStrategy("majority")
    s.SetMajority(Random(majorityMinPercent, majorityMaxPercent), Random(majorityMinWait, majorityMaxWait))
    delayMin = Random(attackDelayMin[0], attackDelayMin[1])
    delayMax = Random(attackDelayMax[0], attackDelayMax[1])
    if delayMax < delayMin {
        delayMax = delayMin
    }
    s.SetAttackDelay(delayMin, delayMax)
    s.SetDeleteCombatReports(deleteReports)
    s.SetFarmSpeed(HUNDRED_PERCENT)
    s.SetPriorityRatio(1, 1, 1)
    session, err = s.BuildFarmSession()
    if err != nil {
        Notify("error", "Farm session " + name + " failed: " + err)
        return ""
    }
    Notify("info", "Farm session " + session.ID + ": " + name + " from " + origin.GetCoordinate())
    return session.ID
}

// In practice BuildFarmSession() switches the farmer on when nothing is running (the docs say it
// should not), so switch it straight back off. The campaign it was running goes back to rest.
func KeepFarmerOff() {
    if IsRunningFarmingBot() {
        StopFarmingBot()
        Notify("info", "Farmer switched back off")
    }
}

// State of a campaign by ID ("active", "paused", "queued", "idle"), "" if not found
func SessionState(id) {
    for s in GetFarmSessions() {
        if s.ID == id {
            return s.State
        }
    }
    return ""
}

func CreateAll() {
    // A new session only raids if the farmer is on, so switch it off first. StopAllFarmSessions also
    // empties the queue and drops any paused progress; campaigns stay in the list (ours are deleted next).
    StopFarmingBot()
    StopAllFarmSessions()
    Sleep(Random(2000, 5000))
    deleted = DeleteOldSessions()
    chunks = PlanSessions()
    ids = []
    failed = 0
    for chunk in chunks {
        id = CreateSession(chunk)
        KeepFarmerOff()
        if id != "" {
            ids += [id]
        } else {
            failed = failed + 1
        }
        Sleep(Random(2000, 6000))
    }
    created = len(ids)

    // The campaigns that were switched back off are at rest, not in the queue: put them back in line.
    // The farmer is off, so they wait for the next StartFarmingBot().
    requeued = 0
    for id in ids {
        if SessionState(id) == "idle" {
            QueueFarmSession(id)
            KeepFarmerOff()
            requeued = requeued + 1
            Sleep(Random(500, 1500))
        }
    }
    queued = 0
    for id in ids {
        state = SessionState(id)
        if state == "queued" || state == "active" {
            queued = queued + 1
        }
    }
    Notify("info", "Re-queued " + requeued + " campaigns that the farmer had started")

    msg = "🌾 Farm sessions: " + deleted + " deleted, " + created + " created (" + queued + " waiting), " + failed + " failed"
    if startAfterCreate && created > 0 {
        StartFarmingBot()
        msg = msg + " | farming started"
    } else {
        msg = msg + " | farmer off, waiting for farmSchedule"
    }
    Notify("report", msg)
}

// Sleeps until tomorrow at createHour (plus up to 60 random minutes)
func SleepUntilTomorrow() {
    year, month, day = Date()
    t = Unix(0, 0).AddDate(year - 1970, month - 1, day)    // tomorrow 00:00 UTC
    at = t.Unix() + createHour * 3600 + Random(0, 3600) - timezoneOffsetHours * 3600
    secs = at - GetTimestamp()
    if secs < 3600 {
        secs = secs + 86400
    }
    Notify("info", "Next farm sessions in " + ShortDur(secs))
    Sleep(secs * 1000)
}

for {
    CreateAll()
    if !repeatDaily {
        break
    }
    SleepUntilTomorrow()
}
