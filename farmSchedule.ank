//////////////////////////////////////
// SETTINGS

wakeUpHour = 7                  // server time; the day starts between wakeUpHour and +30 min
timezoneOffsetHours = 1         // server time minus UTC
workCyclesBeforeLunch = 4
workCyclesAfterLunch = 4

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram + Discord | "warn" / "error" = log + Telegram + Discord
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
        // DISCORD_WEBHOOK comes from the bot settings; try keeps the script alive if it is not set
        try {
            if DISCORD_WEBHOOK != "" {
                SendDiscord(DISCORD_WEBHOOK, text)
            }
        } catch {
        }
    }
}

//////////////////////////////////////
// MAIN

func Work(min, max) {
    minutes = Random(min, max)
    Notify("info", "Working for " + minutes + " min")
    ResumeFarmingBot()
    Sleep(minutes * 60 * 1000)
}

func Pause(label, min, max) {
    minutes = Random(min, max)
    Notify("info", label + " for " + minutes + " min")
    PauseFarmingBot()
    Sleep(minutes * 60 * 1000)
}

// Sleeps until tomorrow at wakeUpHour (plus up to 30 random minutes)
func SleepUntilMorning() {
    year, month, day = Date()
    t = Unix(0, 0).AddDate(year - 1970, month - 1, day)    // tomorrow 00:00 UTC
    wakeAt = t.Unix() + wakeUpHour * 3600 + Random(0, 1800) - timezoneOffsetHours * 3600
    secs = wakeAt - GetTimestamp()
    Notify("report", "😴 Day finished, farming paused. Waking up in " + ShortDur(secs))
    Sleep(secs * 1000)
}

for {
    // --- Start of the day ---
    Notify("report", "☀️ Day started")
    Work(20, 40)                            // farm a bit after waking up
    Pause("Going to work", 21, 30)

    // --- Work cycles before lunch ---
    for i = 0; i < workCyclesBeforeLunch; i++ {
        Work(22, 40)
        Pause("Break", 5, 20)
    }

    // --- Lunch break ---
    Pause("Lunch", 50, 75)

    // --- Work cycles after lunch ---
    for i = 0; i < workCyclesAfterLunch; i++ {
        Work(15, 40)
        Pause("Break", 5, 25)
    }

    // --- Night ---
    PauseFarmingBot()
    SleepUntilMorning()
}
