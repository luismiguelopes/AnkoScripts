//////////////////////////////////////
// SETTINGS

// Sends every Large Cargo from each moon down to its planet (Park)

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

//////////////////////////////////////
// MAIN

Notify("report", "🚀 Moons ➡️ Planets started")

sent = 0
failed = 0
for moon in GetCachedMoons() {
    origin = moon.Coordinate
    destination = NewCoordinate(origin.Galaxy, origin.System, origin.Position, PLANET_TYPE)

    // Simulate a human-like analysis pause
    Sleep(Random(1000, 3000))

    allShips, err = GetCachedCelestial(origin).GetShips()
    if err != nil {
        failed = failed + 1
        Notify("error", "Could not read ships on " + origin + ": " + err)
        continue
    }
    lcToSend = allShips.LargeCargo
    if lcToSend == 0 {
        Notify("info", "No Large Cargos on " + origin + ", skipping")
        continue
    }

    fleet = NewFleet()
    fleet.SetOrigin(origin)
    fleet.SetDestination(destination)
    fleet.SetMission(PARK)
    fleet.AddShips(LARGECARGO, lcToSend)
    fleet, err = fleet.SendNow()

    if err != nil {
        failed = failed + 1
        Notify("error", "🌙 " + origin + " ➡️ 🪐 " + destination + " failed: " + err)
        Sleep(Random(1000, 2000))
    } else {
        sent = sent + 1
        Notify("info", "🌙 " + origin + " ➡️ 🪐 " + destination + " ::: " + lcToSend + " LC")
        Sleep(Random(7000, 15000))  // More human-like delay
    }
}

Notify("report", "🎯 Moons ➡️ Planets done. Sent: " + sent + " | Failed: " + failed)
