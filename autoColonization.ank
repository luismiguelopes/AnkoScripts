//////////////////////////////////////
// SETTINGS

destinationGalaxy = 3
minSystem = 240
maxSystem = 260
minPosition = 7
maxPosition = 9

minFields = 290          // colonies with fewer fields are abandoned
maxFailedSends = 10      // consecutive failed sends before the script gives up
startDelayMinutes = 5    // safety delay before the first send

//////////////////////////////////////
// COMMON (same block in every script)

UserName = GetCachedPlayer().PlayerName
UniverseName = GetUniverseName()

// level: "info" = bot log only | "report" = log + Telegram | "warn" / "error" = log + Telegram
func Notify(level, msg) {
    text = UserName + " (" + UniverseName + ") ::: " + msg
    if level == "error" {
        LogError(text)
    } else if level == "warn" {
        LogWarn(text)
    } else {
        LogInfo(text)
    }
    if level != "info" {
        SendTelegram(TELEGRAM_CHAT_ID, text)
    }
}

// Returns our planet at the given coordinate, or nil
func FindPlanetAt(coord) {
    for p in GetPlanets() {
        c = p.Coordinate
        if c.Galaxy == coord.Galaxy && c.System == coord.System && c.Position == coord.Position {
            return p
        }
    }
    return nil
}

origin = GetHomeWorld()

Notify("report", "AutoColonization starts in " + startDelayMinutes + " min. Target: G" + destinationGalaxy + " systems " + minSystem + "-" + maxSystem + " positions " + minPosition + "-" + maxPosition + ", min fields " + minFields)
Sleep(startDelayMinutes * 60 * 1000)

failedSends = 0
for {
    destination = NewCoordinate(destinationGalaxy, Random(minSystem, maxSystem), Random(minPosition, maxPosition), PLANET_TYPE)

    // Never target a spot we already own
    if FindPlanetAt(destination) != nil {
        continue
    }

    fleet = NewFleet()
    fleet.SetOrigin(origin)
    fleet.SetDestination(destination)
    fleet.SetMission(COLONIZE)
    fleet.AddShips(COLONYSHIP, 1)
    fleet, err = fleet.SendNow()

    if err != nil {
        failedSends = failedSends + 1
        Notify("info", "Send to " + destination + " failed: " + err)
        if failedSends >= maxFailedSends {
            Notify("error", "Stopping: " + failedSends + " failed sends in a row. Last error: " + err)
            break
        }
        Sleep(Random(2000, 5000))
        continue
    }
    failedSends = 0

    ships = NewShipsInfos()
    ships.Set(COLONYSHIP, 1)
    secs, _ = FlightTime(origin.GetCoordinate(), destination, HUNDRED_PERCENT, *ships)
    Notify("info", "ColonyShip sent to " + destination + ". Arrival in " + (secs / 60) + " min")
    Sleep((secs + 15) * 1000)

    // Only ever touch the planet at the destination coordinate
    colony = FindPlanetAt(destination)
    if colony == nil {
        Notify("warn", "No colony at " + destination + " after arrival (spot taken?). Trying another spot.")
        continue
    }

    totalFields = GetCachedCelestial(colony.ID).GetFields().Total
    if totalFields < minFields {
        Abandon(colony.ID)
        Notify("report", "🗑️ Abandoned " + destination + ": only " + totalFields + " fields")
        continue
    }

    Notify("report", "✅ New colony kept at " + destination + " with " + totalFields + " fields")
    break
}
